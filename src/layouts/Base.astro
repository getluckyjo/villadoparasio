---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { waLink } from "../config";
const wa = waLink();

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Vila do Paraíso — Barefoot luxury in Vilanculos, Mozambique",
  description = "Vila do Paraíso (Villa do Paraiso), Vilanculos, Mozambique — private beachfront villas with butler, chef & full board, gateway to the Bazaruto Archipelago. World-class fishing, diving & family holidays, one hour from Johannesburg.",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ogImage = new URL(`${base}/images/vdp_05.jpg`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380;9..144,460;9..144,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scroll-triggered sticky enquiry bar (mobile-first) -->
    <div class="sticky-cta" id="stickyCta" aria-hidden="true">
      <span>Plan your stay</span>
      <a class="btn btn-primary" href={wa} target="_blank" rel="noopener">Enquire on WhatsApp</a>
    </div>

    <a class="wa" href={wa} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
      <span aria-hidden="true">💬</span> WhatsApp
    </a>

    <script>
      const bar = document.getElementById("stickyCta");
      if (bar) {
        const onScroll = () => {
          const show = window.scrollY > window.innerHeight * 0.6;
          bar.classList.toggle("is-visible", show);
          bar.setAttribute("aria-hidden", show ? "false" : "true");
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
